{
  "expo": {
    "name": "KIRA GAJI MY",
    "slug": "kira-gaji",
    "version": "1.11.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B3D2E",
    "android": {
      "package": "com.rickyazwan.kiragaji",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B3D2E"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B3D2E"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KIRA GAJI perlukan akses gambar untuk melampirkan resit. Gambar disimpan dalam telefon anda sahaja.",
          "cameraPermission": "KIRA GAJI perlukan kamera untuk mengambil gambar resit. Gambar disimpan dalam telefon anda sahaja.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F6E56",
          "defaultChannel": "resit"
        }
      ]
    ]
  }
}
